[Unit]
Description=Back up the LeStash database daily, 10 minutes before sysbak's 04:00 snapshot

[Timer]
# Once a day: each copy is a new 1.3 GB file that snapshots cannot share,
# so a 4-hourly copy cost about six times the space. See docs/backups.md.
OnCalendar=*-*-* 03:50:00
Persistent=true

[Install]
WantedBy=timers.target
