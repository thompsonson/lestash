[Unit]
Description=Import the newest Kobo snapshot into LeStash
# Started by lestash-kobo.service once the snapshot is taken. Not tied to the device:
# it reads the snapshot store, so it keeps running after the Kobo is ejected.

[Service]
Type=oneshot
ExecStart=/home/linuxbrew/.linuxbrew/bin/uv run --project %h/Projects/thompsonson/lestash lestash sources sync kobo
WorkingDirectory=%h/Projects/thompsonson/lestash
