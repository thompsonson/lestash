[Unit]
Description=Snapshot the Kobo when it is plugged in, then import it into LeStash
# Started by udev (deploy/99-lestash-kobo.rules). Stops if the Kobo is unplugged mid-copy;
# a stopped snapshot leaves nothing behind.
BindsTo=dev-disk-by\x2dlabel-KOBOeReader.device
After=dev-disk-by\x2dlabel-KOBOeReader.device

[Service]
Type=oneshot
# Full paths: Homebrew's mount and umount come first in PATH and are not setuid.
# The fstab line makes the mount read-only, so nothing can write to the Kobo.
ExecStart=/bin/sh -c 'findmnt -q /media/kobo || /usr/bin/mount /media/kobo'
ExecStart=/home/linuxbrew/.linuxbrew/bin/uv run --project %h/Projects/thompsonson/lestash lestash kobo snapshot --from /media/kobo
# The import reads the snapshot store, not the Kobo, so it runs in its own unit: it is
# not stopped when the Kobo is unplugged.
ExecStart=/usr/bin/systemctl --user start --no-block lestash-kobo-sync.service
# Unmount, so the Kobo can be unplugged safely. umount does not eject: the Kobo may stay
# on its Connected screen until unplugged (ejecting needs root or a polkit rule).
ExecStart=/usr/bin/umount /media/kobo
# Unmount even when a step failed
ExecStopPost=/bin/sh -c 'if findmnt -q /media/kobo; then /usr/bin/umount /media/kobo; fi'
WorkingDirectory=%h/Projects/thompsonson/lestash
