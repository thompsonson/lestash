[Unit]
Description=Snapshot the Kobo when it is plugged in, import it, write its collections, copy PDFs to it, and eject it
# Started by udev (deploy/99-lestash-kobo.rules). Stops if the Kobo is unplugged mid-copy;
# the next snapshot sweeps what a stopped one left behind.
BindsTo=dev-disk-by\x2dlabel-KOBOeReader.device
After=dev-disk-by\x2dlabel-KOBOeReader.device

[Service]
Type=oneshot
# Holds a flag saying this unit did the mount, so it never unmounts yours
RuntimeDirectory=lestash-kobo
# Full paths: Homebrew's mount and umount come first in PATH and are not setuid.
# The fstab line makes the mount read-only, so nothing can write to the Kobo.
# mountpoint, not findmnt: util-linux 2.37's findmnt has no -q.
ExecStart=/bin/sh -c '/usr/bin/mountpoint -q /media/kobo || { /usr/bin/mount /media/kobo && touch "$RUNTIME_DIRECTORY/mounted"; }'
ExecStart=/home/linuxbrew/.linuxbrew/bin/uv run --project %h/Projects/thompsonson/lestash lestash kobo snapshot --from /media/kobo
# The import reads the snapshot store, not the Kobo, so it runs in its own unit and
# isn't stopped by an unplug. A new instance each time: a start request for a unit
# that is still running would merge into it and import nothing new. Imports take a
# lock, so they run one after the other.
ExecStart=/bin/sh -c '/usr/bin/systemctl --user start --no-block "lestash-kobo-sync@$(date +%%s%%N).service"'
# Unmount (only if this unit mounted it). The "ours" flag lets the next steps write to,
# and eject, only a Kobo this unit mounted.
ExecStart=/bin/sh -c 'if [ -e "$RUNTIME_DIRECTORY/mounted" ]; then /usr/bin/umount /media/kobo && rm "$RUNTIME_DIRECTORY/mounted" && touch "$RUNTIME_DIRECTORY/ours" "$RUNTIME_DIRECTORY/eject"; fi'
# Write the collections shown on the Kobo (K8, #315), after the snapshot, which is the
# backup. It mounts /media/kobo-rw only when something changes, checks the database is
# the snapshot's and is saved, and unmounts. A failure is logged in Settings → Sources,
# and the eject still runs. Paused while the switch file kobo-writes-paused exists.
# Switch files live in lestash.core.paths.config_dir(). A unit can't import it, so it
# spells the same rule: $XDG_CONFIG_HOME, else ~/.config, then lestash/.
# Then copy the PDFs asked for (#338) into LeStash/, never over a file; the Kobo
# imports them at the eject. A failure is logged the same way.
ExecStart=/bin/sh -c 'if [ -e $${XDG_CONFIG_HOME:-%h/.config}/lestash/kobo-writes-paused ]; then rm -f "$RUNTIME_DIRECTORY/ours"; echo "Collection writes paused: $${XDG_CONFIG_HOME:-%h/.config}/lestash/kobo-writes-paused exists."; fi; if [ -e "$RUNTIME_DIRECTORY/ours" ]; then rm "$RUNTIME_DIRECTORY/ours"; /home/linuxbrew/.linuxbrew/bin/uv run --project %h/Projects/thompsonson/lestash lestash kobo write-collections --mount || echo "Collection write failed; see Settings, Sources."; /home/linuxbrew/.linuxbrew/bin/uv run --project %h/Projects/thompsonson/lestash lestash kobo copy-files --mount || echo "Copying PDFs failed; see Settings, Sources."; fi'
# Eject, so the Kobo leaves USB mode: only then does it save its database and import
# new books. umount alone left it on its Connected screen for 30 hours. Ejecting needs
# the polkit grant install-root.sh adds. A failed eject fails this unit. The eject
# removes the disk, which stops this unit (BindsTo); nothing runs after it.
# Not while the switch file kobo-no-eject exists, to keep the Kobo's files open on the desktop.
ExecStart=/bin/sh -c 'if [ -e $${XDG_CONFIG_HOME:-%h/.config}/lestash/kobo-no-eject ]; then rm -f "$RUNTIME_DIRECTORY/eject"; echo "Not ejecting: $${XDG_CONFIG_HOME:-%h/.config}/lestash/kobo-no-eject exists."; fi; if [ -e "$RUNTIME_DIRECTORY/eject" ]; then rm "$RUNTIME_DIRECTORY/eject"; /home/linuxbrew/.linuxbrew/bin/uv run --project %h/Projects/thompsonson/lestash lestash kobo eject; fi'
# The same when a step failed
ExecStopPost=/bin/sh -c 'if [ -e "$RUNTIME_DIRECTORY/mounted" ] && /usr/bin/mountpoint -q /media/kobo; then /usr/bin/umount /media/kobo; fi'
WorkingDirectory=%h/Projects/thompsonson/lestash
